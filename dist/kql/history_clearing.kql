// Shell History Cleared Or Disabled. Generated from rules/history_clearing.yml by tools/build.py; do not edit.
Cowrie_CL
| where eventid =~ "cowrie.command.input" and input matches regex "history\\s+-c|unset\\s+HIST(FILE|SIZE)|HISTFILE=/dev/null|HISTSIZE=0|(\\brm\\b|>|\\bln\\s+-sf\\s+/dev/null)[^;&|]*\\.bash_history"
